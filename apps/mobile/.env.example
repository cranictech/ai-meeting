# Meeti mobile — configuration template (safe to commit; no secrets here)
#
# Copy to `.env` and set values for your environment:  cp .env.example .env
#
# EXPO_PUBLIC_API_URL pins the backend the app talks to.
#   - LEAVE EMPTY for local development: the app auto-detects the Expo
#     dev-server host over your LAN, and falls back to http://localhost:3000
#     (iOS simulator / web) or http://10.0.2.2:3000 (Android emulator).
#   - SET IT for a production build pointing at your deployed API, e.g.:
#       EXPO_PUBLIC_API_URL=https://api.yourdomain.com
#
# You can also override the URL at runtime from the app's in-app
# Server Settings screen (stored locally, takes precedence over this value).
EXPO_PUBLIC_API_URL=
